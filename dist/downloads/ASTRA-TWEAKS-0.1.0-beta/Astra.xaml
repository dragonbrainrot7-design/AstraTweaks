<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ASTRA TWEAKS · 0.1.0 bêta" Width="1180" Height="800" MinWidth="960" MinHeight="650" WindowStartupLocation="CenterScreen" Background="#0B0B12" Foreground="#F2F0FA" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A5A1B7"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F4F1FF"/><Setter Property="Background" Value="#24202F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#C4AAFF"/><Setter TargetName="Bd" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="15,13"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#14131D"/><Setter Property="BorderBrush" Value="#292633"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F3F0FA"/><Setter Property="Background" Value="#1C1928"/><Setter Property="BorderBrush" Value="#443A5A"/><Setter Property="Padding" Value="10"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F0FA"/><Setter Property="FontSize" Value="15"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#101017" BorderBrush="#25222F" BorderThickness="0,0,1,0" Padding="18,28">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="✦  A S T R A" FontSize="24" FontWeight="Bold"/><TextBlock Text="T W E A K S" Foreground="#9889B7" Margin="32,3,0,32" FontSize="10"/>
          <TextBlock Text="VOTRE ESPACE" Foreground="#716C83" FontSize="10" Margin="15,0,0,12"/>
          <Button x:Name="NavHome" Content="◈   Vue d'ensemble" Style="{StaticResource Nav}"/>
          <Button x:Name="NavTweaks" Content="⚡   Optimisations" Style="{StaticResource Nav}"/>
          <Button x:Name="NavPower" Content="◉   Astra Power" Style="{StaticResource Nav}"/>
          <Button x:Name="NavDiagnostics" Content="⌁   Diagnostics" Style="{StaticResource Nav}"/>
          <Button x:Name="NavRestore" Content="↶   Restauration" Style="{StaticResource Nav}"/>
          <Button x:Name="NavLanguage" Content="◎   Langue" Style="{StaticResource Nav}"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom"><Border Background="#181721" CornerRadius="8" Padding="14"><StackPanel><TextBlock Text="●  Exécution locale" Foreground="#9CE3BF" FontSize="12"/><TextBlock Text="Aucune télémétrie ASTRA" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="0.1.0 · BÊTA PORTABLE" Foreground="#716C83" FontSize="10" Margin="14,17,0,0"/></StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="34,24,34,18">
      <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
      <DockPanel><TextBlock Text="CENTRE DE CONTRÔLE" FontSize="10" Foreground="#8F879E" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="HeaderLanguage" Content="FR / EN" Padding="12,6" FontSize="11" Margin="0,0,16,0"/><TextBlock Text="WINDOWS 10 / 11   ·   BÊTA" FontSize="10" Foreground="#BBA0F5" VerticalAlignment="Center"/></StackPanel></DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,10,12">
        <Grid>
          <StackPanel x:Name="PageHome">
            <TextBlock Text="Votre PC. Son plein potentiel." FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Comprendre, configurer, mesurer. Vous gardez la main." Foreground="{StaticResource Muted}" Margin="0,10,0,26"/>
            <Border CornerRadius="14" Padding="28" BorderThickness="1" BorderBrush="#62408A"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#36204F" Offset="0"/><GradientStop Color="#191425" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="PRÊT POUR VOTRE PROCHAINE SESSION" Foreground="#CEAAFF" FontSize="10"/><TextBlock Text="Un système à votre rythme." FontSize="26" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Examinez les réglages, sauvegardez vos valeurs d'origine et appliquez votre sélection." Foreground="#BDB1D0" MaxWidth="550" HorizontalAlignment="Left"/><Button x:Name="HomeTweaks" Content="Explorer les optimisations   →" Background="#8750DE" HorizontalAlignment="Left" Margin="0,22,0,0"/></StackPanel></Border>
            <UniformGrid Columns="3" Margin="0,20,0,20">
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="PROCESSEUR" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="CpuStat" Text="—" FontSize="30" Margin="0,10,0,5"/><TextBlock Text="Charge · instantané" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
              <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="MÉMOIRE LIBRE" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="RamStat" Text="—" FontSize="30" Margin="0,10,0,5"/><TextBlock x:Name="RamTotal" Text="Cliquez sur Analyser" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="VOTRE CONFIGURATION" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="12 réglages" FontSize="27" Margin="0,10,0,5"/><TextBlock Text="Disponibilité vérifiée localement" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
            </UniformGrid>
            <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Votre matériel" FontSize="18" FontWeight="SemiBold"/><Button x:Name="Analyze" Content="Analyser / Actualiser" HorizontalAlignment="Right" Padding="14,8"/></DockPanel><TextBlock x:Name="SystemText" Text="L'analyse est en lecture seule. Aucun réglage n'est appliqué automatiquement." Foreground="{StaticResource Muted}" Margin="0,18,0,0" LineHeight="24"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageTweaks" Visibility="Collapsed"><TextBlock Text="Moins de bruit. Plus de contrôle." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Sélectionnez les changements, puis consultez les valeurs exactes avant de les appliquer." Foreground="{StaticResource Muted}" Margin="0,10,0,20"/>
            <WrapPanel Margin="0,0,0,18"><Button x:Name="SelectRecommended" Content="Sélection conseillée" Margin="0,0,10,8"/><Button x:Name="ClearSelection" Content="Tout décocher" Margin="0,0,10,8"/><Button x:Name="ApplyTweaks" Content="Examiner ma sélection  →" Background="#8750DE" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="Les préférences d'interface et de confidentialité ne garantissent pas de gains de FPS. Une nouvelle connexion peut être nécessaire." Foreground="#C7B0E8" Margin="0,0,0,18"/><StackPanel x:Name="TweakList"/>
          </StackPanel>
          <StackPanel x:Name="PagePower" Visibility="Collapsed"><TextBlock Text="La puissance, à votre rythme." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Chaque profil est une copie dédiée de votre plan actuel. Le plan d'origine reste disponible." Foreground="{StaticResource Muted}" Margin="0,10,0,24"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="⚡  ASTRA PERFORMANCE" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Secteur : CPU 5–100 %, préférence énergétique 25. Batterie : CPU 5–80 %. Un profil à mesurer pendant vos jeux." Foreground="{StaticResource Muted}" Margin="0,12,0,18"/><Button x:Name="PowerPerformance" Content="Examiner Performance  →" Background="#8750DE" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="◈  ASTRA BALANCED" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Secteur : CPU 5–100 %, préférence énergétique 50. Batterie : CPU 5–80 %. Pour un usage quotidien équilibré." Foreground="{StaticResource Muted}" Margin="0,12,0,18"/><Button x:Name="PowerBalanced" Content="Examiner Balanced  →" HorizontalAlignment="Left"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="◌  ASTRA ECO" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="CPU 5–80 % sur secteur et batterie, préférence énergétique secteur 80. Réduit la capacité maximale autorisée." Foreground="{StaticResource Muted}" Margin="0,12,0,18"/><Button x:Name="PowerEco" Content="Examiner Eco  →" HorizontalAlignment="Left"/></StackPanel></Border>
            <TextBlock Text="Selon le matériel et Modern Standby, powercfg peut refuser un profil. ASTRA annule alors l'opération. Le mode Adaptatif n'est pas inclus dans cette bêta." Foreground="{StaticResource Muted}" Margin="0,20,0,0"/>
          </StackPanel>
          <StackPanel x:Name="PageDiagnostics" Visibility="Collapsed"><TextBlock Text="Mesurer avant de conclure." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Des données utiles, avec leurs limites clairement indiquées." Foreground="{StaticResource Muted}" Margin="0,10,0,24"/>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Diagnostic réseau" FontSize="19"/><TextBlock Text="6 requêtes ICMP vers l'IP choisie. Ce test contacte cette destination ; il ne mesure pas le ping de votre jeu." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/><WrapPanel><TextBox x:Name="PingTarget" Text="1.1.1.1" Width="170" Margin="0,0,12,0"/><Button x:Name="RunPing" Content="Mesurer"/></WrapPanel><TextBlock x:Name="PingResult" Text="Aucun test effectué." Margin="0,16,0,0" Foreground="#C9B3F1"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="Frametimes &amp; comparaison" FontSize="19"/><TextBlock Text="Importez un CSV contenant FrameTimeMs ou MsBetweenPresents. ASTRA calcule les FPS moyens et les lows à partir de mesures externes ; aucune capture FPS n'est intégrée." Foreground="{StaticResource Muted}" Margin="0,10,0,16"/><WrapPanel><Button x:Name="ImportBefore" Content="Importer le test A" Margin="0,0,12,8"/><Button x:Name="ImportAfter" Content="Importer le test B" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="BenchmarkResult" Text="Même scène, même durée, mêmes réglages pour comparer." Foreground="#C9B3F1" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Outils Windows &amp; rapport local" FontSize="19"/><WrapPanel Margin="0,16,0,0"><Button x:Name="Startup" Content="Lister le démarrage" Margin="0,0,10,10"/><Button x:Name="OpenStartup" Content="Gérer le démarrage ↗" Margin="0,0,10,10"/><Button x:Name="OpenGraphics" Content="Graphismes ↗" Margin="0,0,10,10"/><Button x:Name="OpenStorage" Content="Stockage ↗" Margin="0,0,10,10"/><Button x:Name="ExportReport" Content="Exporter le rapport JSON" Margin="0,0,10,10"/></WrapPanel><TextBlock x:Name="StartupResult" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/></StackPanel></Border>
          </StackPanel>
          <StackPanel x:Name="PageRestore" Visibility="Collapsed"><TextBlock Text="Toujours un chemin de retour." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Restaurez d'abord la dernière opération. Les valeurs et types d'origine sont conservés dans votre profil utilisateur." Foreground="{StaticResource Muted}" Margin="0,10,0,20"/><Button x:Name="RefreshHistory" Content="Actualiser l'historique" HorizontalAlignment="Left" Margin="0,0,0,18"/><StackPanel x:Name="HistoryList"/><TextBlock Text="Les sauvegardes ASTRA concernent uniquement les modifications de cette application. Elles ne remplacent pas une sauvegarde système. Un changement externe conflictuel bloque la restauration." Foreground="{StaticResource Muted}" Margin="0,20,0,0"/></StackPanel>
          <StackPanel x:Name="PageLanguage" Visibility="Collapsed"><TextBlock Text="ASTRA, dans votre langue." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Choisissez la langue de l'interface. Votre préférence est mémorisée sur ce PC." Foreground="{StaticResource Muted}" Margin="0,10,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Langue / Language" FontSize="19"/><ComboBox x:Name="LanguageSelector" Width="280" HorizontalAlignment="Left" Margin="0,20,0,18" Padding="12,10" FontSize="15" Foreground="#17111F" Background="#E8DEF7"><ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><TextBlock Text="Le changement est immédiat et conserve vos sélections. Les noms techniques et les messages fournis par Windows gardent leur langue d'origine." Foreground="{StaticResource Muted}"/></StackPanel></Border></StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderBrush="#292633" BorderThickness="0,1,0,0" Padding="0,12,0,0"><TextBlock x:Name="Status" Text="Prêt. Aucun changement automatique." Foreground="#A9A2BB" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></Border>
    </Grid>
  </Grid>
</Window>
